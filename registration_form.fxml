<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>

<GridPane fx:controller="eu.ase.jfxmltest.RegistrationFormController"
          xmlns:fx="http://javafx.com/fxml"
          alignment="center"
          hgap="10"
          vgap="10">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <columnConstraints>
        <ColumnConstraints minWidth="100"
                           prefWidth="100"
                           maxWidth="Infinity"
                           halignment="RIGHT"/>
        <ColumnConstraints minWidth="200"
                           prefWidth="200"
                           maxWidth="Infinity"
                           hgrow="ALWAYS"/>
        <ColumnConstraints minWidth="260"
                           prefWidth="260"
                           maxWidth="Infinity"/>
    </columnConstraints>

    <Label text="Registration Form (FXML)"
           GridPane.columnIndex="0"
           GridPane.rowIndex="0"
           GridPane.columnSpan="3"
           GridPane.rowSpan="1"
           GridPane.halignment="CENTER">
        <font>
            <Font name="Arial" size="24"/>
        </font>
        <GridPane.margin>
            <Insets top="20" right="0" bottom="20" left="0"/>
        </GridPane.margin>
    </Label>

    <Label text="Full Name : "
           GridPane.columnIndex="0"
           GridPane.rowIndex="1"/>

    <TextField fx:id="nameField"
               prefHeight="40"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"/>

    <Button fx:id="submitButton"
            text="Submit std."
            prefWidth="250"
            prefHeight="40"
            defaultButton="true"
            GridPane.columnIndex="2"
            GridPane.rowIndex="1"
            GridPane.columnSpan="1"
            GridPane.rowSpan="1"
            GridPane.halignment="CENTER"
            onAction="#handleSubmitButtonAction">
        <GridPane.margin>
            <Insets top="20" right="0" bottom="20" left="0"/>
        </GridPane.margin>
    </Button>

    <Label text="Email ID : "
           GridPane.columnIndex="0"
           GridPane.rowIndex="2"/>

    <TextField fx:id="emailField"
               prefHeight="40"
               GridPane.columnIndex="1"
               GridPane.rowIndex="2"/>

    <Button fx:id="submitMThButton"
            text="Submit multi-threading"
            prefWidth="250"
            prefHeight="40"
            defaultButton="false"
            GridPane.columnIndex="2"
            GridPane.rowIndex="2"
            GridPane.columnSpan="1"
            GridPane.rowSpan="1"
            GridPane.halignment="CENTER"
            onAction="#handleSubmitMThButtonAction">
        <GridPane.margin>
            <Insets top="20" right="0" bottom="20" left="0"/>
        </GridPane.margin>
    </Button>

    <Label text="Password : "
           GridPane.columnIndex="0"
           GridPane.rowIndex="3"/>

    <PasswordField fx:id="passwordField"
                   prefHeight="40"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

    <Button fx:id="submitReactStreamsButton"
            text="Submit reactive streams"
            prefWidth="250"
            prefHeight="40"
            defaultButton="false"
            GridPane.columnIndex="2"
            GridPane.rowIndex="3"
            GridPane.columnSpan="1"
            GridPane.rowSpan="1"
            GridPane.halignment="CENTER"
            onAction="#handleSubmitReactStreamsButtonAction">
        <GridPane.margin>
            <Insets top="20" right="0" bottom="20" left="0"/>
        </GridPane.margin>
    </Button>

    <Button fx:id="displayButton"
            text="Display rows"
            prefWidth="200"
            prefHeight="40"
            defaultButton="false"
            GridPane.columnIndex="0"
            GridPane.rowIndex="5"
            GridPane.columnSpan="3"
            GridPane.rowSpan="1"
            GridPane.halignment="CENTER"
            onAction="#handleDisplayButtonAction">
        <GridPane.margin>
            <Insets top="20" right="0" bottom="20" left="0"/>
        </GridPane.margin>
    </Button>

</GridPane>